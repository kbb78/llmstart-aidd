# При деплое на Railway задайте эти переменные в разделе Variables дашборда Railway.
# PORT задаётся Railway автоматически — добавлять вручную не нужно.
TELEGRAM_BOT_TOKEN=
LLM_PROVIDER=openrouter
LLM_MODEL=
SYSTEM_PROMPT=Ты — онлайн-преподаватель. Когда пользователь называет тему, развёрнуто объясни её простым языком с примерами. После объяснения задай 1–2 проверочных вопроса, чтобы убедиться, что материал усвоен. Если пользователь задаёт уточняющий вопрос — ответь на него, прежде чем двигаться дальше.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MAX_TOKENS=1500
MAX_HISTORY_MESSAGES=20
LOG_LEVEL=INFO
